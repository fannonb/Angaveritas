# --- Database (Supabase: Project Settings > Database > Connection string > "Transaction pooler") ---
DATABASE_URL=postgresql://angaveritas_runtime.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Optional PEM CA for a remote database that uses a private certificate authority.
# DATABASE_CA_CERT=

# --- Staff authenticator encryption ---
# Generate and retain this key with: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
# STAFF_MFA_KEY=

# --- Places & routing (OpenStreetMap-based, swappable) ---
# Place search (Photon API format). Public instance has fair-use limits.
GEOCODER_URL=https://photon.komoot.io/api/
# Road distance (OSRM API format). The public demo server is for testing only;
# for production use your own OSRM or a hosted OSRM-compatible service.
ROUTER_URL=https://router.project-osrm.org/route/v1/driving/

# --- Business email notifications (resend.com) ---
# RESEND_API_KEY=re_...
# info@angaveritas.com always receives team alerts and copies of business emails.
# Optional additional team inboxes, separated by commas. Auth links are never copied.
# NOTIFY_EMAIL=info@angaveritas.com

# Used for links in emails
APP_URL=https://angaveritas.com
# Used to hash IP addresses for spam limits (any long random string)
IP_HASH_SALT=change-me
# For a self-hosted reverse proxy, enable only if it overwrites forwarded headers and the origin is private.
# TRUST_PROXY_HEADERS=true

# --- File storage ---
# local: files in STORAGE_DIR (development). r2: private Cloudflare R2 bucket (production). supabase: private Supabase Storage bucket.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_BUCKET=angaveritas-private
# R2 (Cloudflare): set STORAGE_DRIVER=r2 and these. Create the access key under R2 > Manage API Tokens.
# R2_ACCOUNT_ID=<value>
# R2_ACCESS_KEY_ID=<value>
# R2_SECRET_ACCESS_KEY=<value>
# R2_BUCKET=angaveritas

# Sender for all emails (must be verified in Resend)
# EMAIL_FROM=AngaVeritas <no-reply@angaveritas.com>

# --- Integration framework ---
# Optional public contact paths (hidden until configured)
# NEXT_PUBLIC_BOOKING_URL=https://your-booking-provider/your-page
# NEXT_PUBLIC_WHATSAPP=+254XXXXXXXXX
# Durable email retries and recurring invoice generation: schedule POST /api/jobs
# with Authorization: Bearer <WORKER_SECRET>. Use a dedicated active admin for attribution.
# WORKER_SECRET=long-random-worker-secret
# Vercel Cron sends this as a Bearer token when it calls /api/jobs (schedule in vercel.json).
# CRON_SECRET=another-long-random-secret
# WORKER_USER_ID=uuid-of-dedicated-worker-admin
# Required for production client document uploads. The scanner accepts raw bytes and returns { "clean": true }.
# FILE_SCAN_URL=https://your-scanner/scan
# FILE_SCAN_KEY=your-scan-service-key
# Paystack hosted checkout: start in test mode. Never expose the secret key to browsers.
# PAYSTACK_ENABLED=false
# PAYSTACK_MODE=test
# PAYSTACK_SECRET_KEY=sk_test_...
# Dedicated active admin UUID for automated payment audit/ledger entries.
# PAYSTACK_ACTOR_ID=
# Enable only the channels activated on your Paystack merchant account.
# PAYSTACK_CHANNELS=card,mobile_money
# Dashboard webhook: https://your-domain/api/payments/paystack/webhook
# Callback: https://your-domain/portal/payments/return
# See docs/PAYSTACK.md for migration, staging and live-payment checks.
